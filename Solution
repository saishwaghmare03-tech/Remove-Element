import java.util.Arrays;

public class Solution {

    public int removeElement(int[] nums, int val) {
        // 'k' tracks the index where the next non-'val' element will be written.
        // It also acts as a counter for the total number of valid elements found.
        int k = 0; 

        // Iterate through each element in the array using pointer 'i'
        for (int i = 0; i < nums.length; i++) {
            
            // LOGIC / EXECUTION FLOW:
            // 1. If the current element (nums[i]) is NOT equal to 'val', it's a valid element.
            // 2. We copy this valid element to the front of the array at index 'k'.
            // 3. We increment 'k' so the next valid element is stored at the next position.
            // 4. If nums[i] IS equal to 'val', we do nothing and skip it (k does not increment).
            if (nums[i] != val) {
                nums[k] = nums[i];
                k++;
            }
        }

        // Return 'k', which represents the number of elements not equal to 'val'.
        // The first 'k' elements of 'nums' now contain all valid values.
        return k;
    }

    public static void main(String[] args) {
        Solution solution = new Solution();

        // -------------------------------------------------------------
        // TEST CASE 1:
        // Input: nums = [3, 2, 2, 3], val = 3
        // Execution Trace:
        // - i = 0: nums[0] is 3 == val (3). Skip.               --> k = 0, nums = [3, 2, 2, 3]
        // - i = 1: nums[1] is 2 != val (3). Write nums[0] = 2.  --> k = 1, nums = [2, 2, 2, 3]
        // - i = 2: nums[2] is 2 != val (3). Write nums[1] = 2.  --> k = 2, nums = [2, 2, 2, 3]
        // - i = 3: nums[3] is 3 == val (3). Skip.               --> k = 2, nums = [2, 2, 2, 3]
        // Result: k = 2, Modified array (first k elements): [2, 2]
        // -------------------------------------------------------------
        int[] nums1 = {3, 2, 2, 3};
        int val1 = 3;

        System.out.println("--- Test Case 1 ---");
        System.out.println("Original nums: " + Arrays.toString(nums1) + ", val: " + val1);

        int k1 = solution.removeElement(nums1, val1);

        System.out.println("Returned k: " + k1);
        System.out.print("First " + k1 + " elements of modified nums: [");
        for (int i = 0; i < k1; i++) {
            System.out.print(nums1[i] + (i < k1 - 1 ? ", " : ""));
        }
        System.out.println("]");
        System.out.println();

        // -------------------------------------------------------------
        // TEST CASE 2:
        // Input: nums = [0, 1, 2, 2, 3, 0, 4, 2], val = 2
        // Result: k = 5, Modified array (first k elements): [0, 1, 3, 0, 4]
        // -------------------------------------------------------------
        int[] nums2 = {0, 1, 2, 2, 3, 0, 4, 2};
        int val2 = 2;

        System.out.println("--- Test Case 2 ---");
        System.out.println("Original nums: " + Arrays.toString(nums2) + ", val: " + val2);

        int k2 = solution.removeElement(nums2, val2);

        System.out.println("Returned k: " + k2);
        System.out.print("First " + k2 + " elements of modified nums: [");
        for (int i = 0; i < k2; i++) {
            System.out.print(nums2[i] + (i < k2 - 1 ? ", " : ""));
        }
        System.out.println("]");
    }
}
